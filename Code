import random

def play_game():
    luck_num = random.randint(1, 50)

    while True:
        user_num = int(input("Guess a number between 1 and 50: "))

        if (user_num == luck_num):
            print("\nCongratulations! You guessed the correct number.")
            break
        elif (user_num < luck_num):
            print("Too low! Try again.")
        else:
            print("Too high! Try again.")

    print("The lucky number was:", luck_num)
    print("Game is over. Thanks for playing the guessing game!")

play_game()
